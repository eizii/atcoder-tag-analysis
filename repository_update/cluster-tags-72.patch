@@ -0,0 +1,76 @@
+# -*- coding: utf-8 -*-
+import csv
+import json
+import sys
+import types
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+ROOT=Path(__file__).resolve().parent.parent
+sys.path.insert(0,str(ROOT))
+from tagger.classify_one import normalize_classification,classify_one
+
+class ClusterTagTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.algorithms=json.loads((ROOT/"prompts/algorithm_tags.json").read_text(encoding="utf-8"))
+        cls.problem=json.loads((ROOT/"data/abc400/abc400_d.json").read_text(encoding="utf-8"))
+
+    def test_wall_breaker_preserves_two_distinct_methods_and_deduplicates(self):
+        result=normalize_classification(dict(task_id="abc400_d",
+            tags=["0-1 BFS","Dijkstra 法","Deque","0-1 BFS"]),self.problem,self.algorithms)
+        self.assertEqual(result["cluster_ids"],["C006","C009"])
+        self.assertEqual(result["tags"],["C006: Deque","C009: Priority Queue / Heap"])
+        self.assertEqual(result["algorithm_tag_ids"],["T007","T144","T187"])
+
+    def test_empty_and_invalid_model_outputs(self):
+        self.assertEqual(normalize_classification(dict(task_id="abc400_d",tags=[]),
+                         self.problem,self.algorithms)["tags"],[])
+        for output in [dict(task_id="other",tags=[]),dict(task_id="abc400_d",tags=["unknown"]),
+                       dict(task_id="abc400_d",tags="Deque")]:
+            with self.assertRaises(ValueError):
+                normalize_classification(output,self.problem,self.algorithms)
+
+    def test_pipeline_maps_fine_model_response_without_network(self):
+        fake=types.ModuleType("tagger.openrouter_client")
+        def respond(prompt):
+            self.assertIn("0-1 BFS",prompt)
+            self.assertIn("115",prompt)
+            return json.dumps(dict(task_id="abc400_d",tags=["Deque","0-1 BFS"]))
+        fake.call_llm=respond
+        with patch.dict(sys.modules,{"tagger.openrouter_client":fake}):
+            result=json.loads(classify_one(str(ROOT/"data/abc400/abc400_d.json")))
+        self.assertEqual(result["cluster_ids"],["C006"])
+        self.assertEqual(result["algorithm_tags"],["Deque","0-1 BFS"])
+
+    def test_exported_dataset_has_only_the_frozen_72_labels(self):
+        labels=json.loads((ROOT/"prompts/tags.json").read_text(encoding="utf-8"))
+        self.assertEqual(len(labels),72)
+        self.assertEqual(len(self.algorithms),115)
+        with (ROOT/"output/all_problems.csv").open(encoding="utf-8-sig",newline="") as stream:
+            rows=list(csv.DictReader(stream))
+        self.assertEqual(len(rows),1473)
+        self.assertEqual(len({r["problem_id"] for r in rows}),899)
+        self.assertEqual({r["tag"] for r in rows},set(labels))
+        with (ROOT/"clustering/all_problems_clustered.csv").open(encoding="utf-8-sig",newline="") as stream:
+            scoped=list(csv.DictReader(stream))
+        self.assertEqual(len(scoped),1472)
+        self.assertEqual(len({r["problem_id"] for r in scoped}),898)
+        actual=[]
+        empty=0
+        for file in (ROOT/"output").rglob("*.json"):
+            obj=json.loads(file.read_text(encoding="utf-8"))
+            if not obj["tags"]:
+                empty+=1
+                continue
+            self.assertTrue(set(obj["tags"])<=set(labels))
+            self.assertEqual(len(obj["tags"]),len(set(obj["tags"])))
+            self.assertEqual(len(obj["tags"]),len(obj["cluster_ids"]))
+            self.assertEqual(len(obj["algorithm_tags"]),len(obj["algorithm_tag_ids"]))
+            actual.extend((obj["task_id"],tag) for tag in obj["tags"])
+        self.assertEqual(empty,696)
+        self.assertEqual(set(actual),{(r["problem_id"],r["tag"]) for r in rows})
