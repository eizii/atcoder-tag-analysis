+.panel{background:white;border:1px solid #dce3ed;border-radius:12px;padding:22px;margin-top:22px}
+.controls{display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:start}
+label{display:block;font-weight:600;margin-bottom:8px}select,input[type=search],input[type=number]{border:1px solid #b8c5d8;border-radius:6px;padding:9px;background:white;font:inherit}
+select,input[type=search]{width:100%}input[type=range]{width:100%;accent-color:#2563eb}
+.cutline{display:flex;align-items:center;gap:12px}input[type=number]{width:96px}
