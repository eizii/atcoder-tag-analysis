diff --git a/utils/import_cluster_tags.py b/utils/import_cluster_tags.py
new file mode 100644
index 0000000..cc32a65
--- /dev/null
+++ b/utils/import_cluster_tags.py
@@ -0,0 +1,152 @@
+# -*- coding: utf-8 -*-
+"""Replace output tags with the frozen 72-cluster taxonomy, without LLM/network calls."""
+from __future__ import annotations
+import csv
+import hashlib
+import importlib.util
+import json
+from collections import Counter, defaultdict
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+VERSION = "hc72-jaccard-average-d0.9-v1"
+FINE = ROOT / "analysis" / "validation" / "revised"
+CLUSTERING = ROOT / "clustering"
+
+def load_csv(file):
+    with file.open(encoding="utf-8-sig",newline="") as stream:
+        return list(csv.DictReader(stream))
+
+def dump_json(file,value):
+    file.parent.mkdir(parents=True,exist_ok=True)
+    file.write_text(json.dumps(value,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
+
+def dump_csv(file,rows,columns):
+    with file.open("w",encoding="utf-8-sig",newline="") as stream:
+        writer=csv.DictWriter(stream,fieldnames=columns,extrasaction="ignore",lineterminator="\n")
+        writer.writeheader()
+        writer.writerows(rows)
+
+def main():
+    summary=json.loads((CLUSTERING/"summary.json").read_text(encoding="utf-8"))
+    assert summary["used_tags"]==115 and summary["models"][0]["cluster_count"]==72
+    assert summary["default_distance_threshold"]==0.9 and summary["linkage"]=="average (UPGMA)"
+    for name in ["all_problems_tagged.csv","problem_tag_matrix.csv","tag_catalog.csv"]:
+        assert hashlib.sha256((FINE/name).read_bytes()).hexdigest()==summary["source_sha256"][name],name
+    members=load_csv(CLUSTERING/"clusters_all.csv")
+    fine_rows=load_csv(FINE/"all_problems_tagged.csv")
+    fine_catalog=load_csv(FINE/"tag_catalog.csv")
+    by_id={r["tag_id"]:r for r in fine_catalog}
+    by_name={r["tag"]:r for r in fine_catalog}
+    assert len(by_id)==len(by_name)==266
+    by_cluster=defaultdict(list)
+    for row in members:
+        by_cluster[row["cluster_id"]].append(row)
+    assert len(members)==115 and len({r["tag_id"] for r in members})==115
+    assert len(by_cluster)==72
+    clusters=[]
+    algorithm_map={}
+    for cid,group in sorted(by_cluster.items()):
+        representative=group[0]["representative_tag"]
+        label=cid+": "+representative
+        entry=dict(cluster_id=cid,label=label,representative=representative,
+            member_tags=[dict(tag_id=r["tag_id"],tag=r["tag"]) for r in group],
+            algorithm_count=len(group),problem_count=int(group[0]["cluster_problem_union_count"]))
+        clusters.append(entry)
+        for member in entry["member_tags"]:
+            algorithm_map[member["tag"]]=dict(member,cluster_id=cid,cluster_label=label)
+    by_problem=defaultdict(list)
+    for r in fine_rows:
+        assert r["tag"] in algorithm_map and r["tag_id"]==algorithm_map[r["tag"]]["tag_id"]
+        by_problem[r["problem_id"]].append(r)
+    assert len(by_problem)==898 and len(fine_rows)==1740
+    current_files={p.stem:p for p in (ROOT/"output").rglob("*.json")}
+    current={pid:json.loads(p.read_text(encoding="utf-8-sig")) for pid,p in current_files.items()}
+    assert set(by_problem)<=set(current)
+    plans={}
+    legacy_extra=[]
+    for pid,obj in current.items():
+        assert obj["task_id"]==pid
+        if pid in by_problem:
+            rows=sorted(by_problem[pid],key=lambda r:r["tag_id"])
+            names=[r["tag"] for r in rows]
+            status="source_revision"
+            review=any(r["needs_review"]=="1" for r in rows)
+        elif obj.get("tags"):
+            # Only exact fine-tag matches are allowed outside the 898-problem revision.
+            # This preserves the already classified abc175_b without inventing new labels.
+            prior=obj.get("previous_tags",obj["tags"])
+            if any(t not in algorithm_map for t in prior):
+                raise ValueError("Cannot safely map out-of-scope legacy tags: "+pid)
+            names=sorted(set(prior),key=lambda t:algorithm_map[t]["tag_id"])
+            rows=[]
+            status="legacy_exact_mapping"
+            review=True
+            legacy_extra.append(pid)
+        else:
+            continue
+        cids=sorted({algorithm_map[t]["cluster_id"] for t in names})
+        labels={c["cluster_id"]:c["label"] for c in clusters}
+        updated=dict(obj)
+        updated.update(previous_tags=obj.get("previous_tags",obj.get("tags",[])),
+            tags=[labels[cid] for cid in cids],cluster_ids=cids,
+            algorithm_tags=names,algorithm_tag_ids=[algorithm_map[t]["tag_id"] for t in names],
+            tagging_version=VERSION,tagging_status=status,tagging_needs_review=review)
+        plans[pid]=updated
+    # Check all mappings before changing any output.
+    allowed={c["label"] for c in clusters}
+    assert all(p["tags"] and len(set(p["tags"]))==len(p["tags"]) and set(p["tags"])<=allowed for p in plans.values())
+    assert len(allowed)==72
+    for pid,obj in plans.items():
+        dump_json(current_files[pid],obj)
+
+    dump_json(CLUSTERING/"cluster_catalog.json",dict(version=VERSION,source_problem_count=898,
+        distance="jaccard",linkage="average",distance_threshold=0.9,clusters=clusters))
+    dump_json(ROOT/"prompts"/"tags.json",{
+        c["label"]:dict(description="クラスタ代表名: "+c["representative"]+
+            "。所属する細かいタグ: "+"、".join(m["tag"] for m in c["member_tags"])+
+            "。同義語の統合ではなく、付与された問題の共通性によるグループ。",
+            cluster_id=c["cluster_id"]) for c in clusters})
+    dump_json(ROOT/"prompts"/"algorithm_tags.json",{
+        name:dict(tag_id=m["tag_id"],cluster_id=m["cluster_id"],cluster_label=m["cluster_label"])
+        for name,m in sorted(algorithm_map.items(),key=lambda kv:kv[1]["tag_id"])})
+    dump_csv(CLUSTERING/"algorithm_to_cluster.csv",list(algorithm_map.values()),
+             ["tag_id","tag","cluster_id","cluster_label"])
+    mapping_rows=[]
+    for pid in sorted(by_problem):
+        obj=plans[pid]
+        mapping_rows.append(dict(problem_id=pid,title=obj.get("title",""),
+            cluster_ids=";".join(obj["cluster_ids"]),cluster_labels=" | ".join(obj["tags"]),
+            algorithm_tag_ids=";".join(obj["algorithm_tag_ids"]),
+            algorithm_tags=" | ".join(obj["algorithm_tags"]),
+            needs_review=int(obj["tagging_needs_review"]),tagging_version=VERSION))
+    dump_csv(CLUSTERING/"problem_clusters.csv",mapping_rows,list(mapping_rows[0]))
+    dump_csv(CLUSTERING/"problem_cluster_matrix.csv",
+        [dict(problem_id=pid,**{c["cluster_id"]:int(c["cluster_id"] in plans[pid]["cluster_ids"])
+         for c in clusters}) for pid in sorted(by_problem)],
+        ["problem_id"]+[c["cluster_id"] for c in clusters])
+
+    # Use the repository's own CSV conversion logic for compatibility.
+    spec=importlib.util.spec_from_file_location("csv_export",ROOT/"utils"/"convert_output_to_csv.py")
+    converter=importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(converter)
+    columns=["tag","problem_id","title","difficulty","diff_band","url"]
+    all_rows=[]
+    for pid in sorted(current):
+        all_rows.extend(converter.json_to_rows(plans.get(pid,current[pid])))
+    scoped_rows=[r for r in all_rows if r["problem_id"] in by_problem]
+    dump_csv(ROOT/"output"/"all_problems.csv",all_rows,columns)
+    dump_csv(CLUSTERING/"all_problems_clustered.csv",scoped_rows,columns)
+    assert len({r["tag"] for r in all_rows})==72
+    manifest=dict(version=VERSION,cluster_count=72,algorithm_tag_count=115,
+        source_problem_count=898,source_fine_tag_pairs=1740,
+        source_cluster_pairs=len(scoped_rows),exported_problem_count=len(plans),
+        exported_cluster_pairs=len(all_rows),legacy_exact_mapped_problems=sorted(legacy_extra),
+        unchanged_empty_output_count=sum(not obj.get("tags") for obj in current.values()),
+        source_hashes=summary["source_sha256"],
+        note="72クラスタは898問の修正案で固定。追加の旧タグは完全一致でのみ対応付け、未分類の問題は推測で補完しない。")
+    dump_json(CLUSTERING/"migration_manifest.json",manifest)
+    print(json.dumps(manifest,ensure_ascii=False,indent=2))
+
+if __name__=="__main__":
+    main()
